# Generate with: npx emdash secrets generate --write .env
# EMDASH_ENCRYPTION_KEY=emdash_enc_v1_...

# In production use the public Next.js origin, e.g. https://rikusen.dev
# EMDASH_SITE_URL=https://rikusen.dev

# Persistent storage (relative to cms/ unless absolute)
EMDASH_DATABASE_URL=file:./data.db
EMDASH_UPLOADS_DIR=./uploads

# Override when the CMS must listen outside this machine (e.g. a container).
# HOST=0.0.0.0
# PORT=4321
