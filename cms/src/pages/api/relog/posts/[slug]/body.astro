---
import type { PortableTextBlock } from "emdash/ui";
import { PortableText } from "emdash/ui";
import PostImage from "../../../../../components/PostImage.astro";
import { publicHeaders, readPublishedPost } from "../../../../../lib/public-posts";

const post = Astro.params.slug ? await readPublishedPost(Astro.params.slug) : null;
if (!post) return new Response(null, { status: 404, headers: publicHeaders });
for (const [key, value] of Object.entries(publicHeaders)) Astro.response.headers.set(key, value);
---
<PortableText value={post.data.content as PortableTextBlock[]} components={{ type: { image: PostImage } }} />
